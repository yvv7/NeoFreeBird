/*
Generic terminology replacements for the "Restore Twitter names" feature, applied
to every localized string and to server-composed text (notification rows etc.).

Lowercase keys match whole words case-insensitively and the replacement copies the
matched word's capitalisation ("Reposts" -> "Retweets", "REPOST" -> "RETWEET").
A replacement carrying its own capital keeps it even for lowercase matches
("posted" -> "Tweeted"). Keys that contain an uppercase letter match exactly and are
replaced verbatim ("X" -> "Twitter").
List each word in only one of the two forms, and never use a replacement value that
matches another key — replacements must be stable if the text is processed twice.

Strictly per-language: a language without its own copy of this file gets no generic
renaming at all.
*/

"yeniden gönderilere göre sırala" = "Retweetleri Sırala";
"yeniden gönderileri kapat" = "Retweetleri Kapat";
"yeniden gönderileri aç" = "Retweetleri Aç";
"yeniden gönderiliyor" = "Retweetleniyor";
"yeniden gönderildi" = "Retweetlendi";
"yeniden gönderdi" = "Retweetledi";
"yeniden gönderiler" = "Retweetler";
"yeniden gönderiyi" = "Retweet'i";
"yeniden gönderi" = "Retweet";
"yeniden gönder" = "Retweetle";

"gönderin gönderildi" = "Tweetin gönderildi";
"gönderin paylaşıldı" = "Tweetin gönderildi";
"gönderi etkileşimlerini" = "Tweet Etkileşimlerini";
"gönderi etkinliği" = "Tweet Etkinliği";
"gönderi sayısı" = "Tweetler";
"gönderi oluştur" = "Tweet at";
"yeni gönderi" = "Yeni Tweet";
"gönderi ayrıntıları" = "Tweet Detayları";
"gönderileri" = "Tweetleri";
"gönderiler" = "Tweetler";
"gönderiyi" = "Tweet'i";
"gönderi" = "Tweet";

"mesaj gönder" = "Mesaj gönder";

"alıntı sayısına göre sırala" = "Alıntı Tweetleri Sırala";
"alıntılar" = "Alıntı Tweetler";
"alıntı" = "Tweeti Alıntıla";

"premium" = "Blue";
"X" = "Twitter";
